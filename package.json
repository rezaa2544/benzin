{
  "name": "benzin",
  "private": true,
  "version": "0.1.0",
  "description": "Benzin — two-sided marketplace for subsidised fuel quotas (Iran)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:api": "pnpm --filter @benzin/api dev",
    "dev:web": "pnpm --filter @benzin/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
