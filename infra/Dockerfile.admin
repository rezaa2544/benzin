# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/admin apps/admin
# Caddy mounts the panel on /admin/ and strips the prefix before proxying here.
ENV ADMIN_BASE=/admin/
RUN pnpm --filter @benzin/shared build && pnpm --filter @benzin/admin build

FROM nginx:1.27-alpine AS runtime
COPY infra/admin-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/admin/dist /usr/share/nginx/html
EXPOSE 4173
