# Copy to .env for local development (never commit real secrets)
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
# Optional. If omitted the API runs with in-memory repositories (dev/test only).
DATABASE_URL=postgres://benzin:benzin@localhost:5432/benzin
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me
OTP_TTL_SECONDS=120

# SMS delivery (D3). Comma separated chain: first is primary, the rest are failover.
# `console` logs the OTP instead of sending it, which is what development and CI use.
SMS_PROVIDERS=console
# SMS_PROVIDERS=smsir,kavenegar
# SMS_API_KEY=
# SMS_SENDER_LINE=30007732xxxx
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER_LINE=10004346
SMS_TIMEOUT_MS=5000

# Payments (E7). `sandbox` approves locally; `zarinpal` needs a merchant id.
PAYMENT_GATEWAY=sandbox
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_BASE_URL=https://payment.zarinpal.com
PAYMENT_CALLBACK_URL=https://app.benzin.ir/payments/callback

# Admin panel (E8). Dev server port and the base path used by production builds;
# Caddy mounts the panel on /admin/ and strips the prefix before proxying.
ADMIN_PORT=4173
# ADMIN_BASE=/admin/
